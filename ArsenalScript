local function hum()
	local c = LP.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function root()
	local c = LP.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function isEnemy(p)
	if not S.TeamCheck then return true end
	return not (LP.Team and p.Team == LP.Team)
end

local StatusLabel
local RefreshList = function() end
local CurrentTarget
local lastStatus = ""

local function updateStatus()
	if not StatusLabel then return end
	local txt
	if S.Aimbot and CurrentTarget then
		txt = "Locked: " .. CurrentTarget.DisplayName
	elseif S.Selected then
		txt = "Selected: " .. S.Selected.DisplayName
	else
		txt = "Target: auto"
	end
	if txt ~= lastStatus then
		lastStatus = txt
		StatusLabel.Text = txt
	end
end

-- AIMBOT
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getAimPart(c)
	return c:FindFirstChild(S.Part) or c:FindFirstChild("HumanoidRootPart")
end

local function getOrigin(cam)
	if S.FollowMouse then return UIS:GetMouseLocation() end
	local vs = cam.ViewportSize
	return Vector2.new(vs.X / 2, vs.Y / 2)
end

local function visibleCheck(part, c, cam)
	if not S.Wall then return true end
	-- ignore every player's character (people standing in between must not block the lock)
	local ignore = { LP.Character }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then table.insert(ignore, pl.Character) end
	end
	rayParams.FilterDescendantsInstances = ignore
	rayParams.RespectCanCollide = true
	rayParams.IgnoreWater = true
	local origin = cam.CFrame.Position
	local dir = part.Position - origin
	for _ = 1, 8 do
		local hit = Workspace:Raycast(origin, dir, rayParams)
		if not hit then return true end
		if hit.Instance.Transparency >= 0.8 then
			-- see-through part (glass, invisible walls): skip it and keep checking
			table.insert(ignore, hit.Instance)
			rayParams.FilterDescendantsInstances = ignore
		else
			return false
		end
	end
	return false
end

local lockedPlayer

-- checks one player: returns the first aimable part (preferred part first) inside the radius
local function evalPlayer(p, cam, origin, radius)
	local c = p.Character
	if p == LP or not p.Parent or not c or not isEnemy(p) then return end
	local h = c:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return end
	for _, n in ipairs({ S.Part, "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
		local part = c:FindFirstChild(n)
		if part and part:IsA("BasePart") then
			local v, on = cam:WorldToViewportPoint(part.Position)
			if on then
				local d = (Vector2.new(v.X, v.Y) - origin).Magnitude
				if d <= radius and visibleCheck(part, c, cam) then
					return part, d
				end
			end
		end
	end
end

local function findTarget(cam)
	local origin = getOrigin(cam)

	-- sticky lock: stay on the current target until they die or leave the (slightly widened) FOV
	if lockedPlayer and (not S.Selected or S.Selected == lockedPlayer) then
		local part = evalPlayer(lockedPlayer, cam, origin, S.Fov * 1.15)
		if part then return lockedPlayer, part end
	end
	lockedPlayer = nil

	local bestP, bestPart, bestD
	local list = S.Selected and { S.Selected } or Players:GetPlayers()
	for _, p in ipairs(list) do
		local part, d = evalPlayer(p, cam, origin, S.Fov)
		if part and (not bestD or d < bestD) then
			bestP, bestPart, bestD = p, part, d
		end
	end
	lockedPlayer = bestP
	return bestP, bestPart
end

local function aimStep(dt)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local o = getOrigin(cam)
	FovCircle.Position = UDim2.fromOffset(o.X, o.Y)
	FovCircle.Size = UDim2.fromOffset(S.Fov * 2, S.Fov * 2)
	FovCircle.Visible = S.ShowFov

	local locked = false
	CurrentTarget = nil
	if not S.Aimbot then lockedPlayer = nil end
	if S.Aimbot and not (S.HoldRMB and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
		local p, part = findTarget(cam)
		if p and part then
			CurrentTarget = p
			locked = true
			local pos = part.Position + part.AssemblyLinearVelocity * (S.Prediction / 100 * 0.3)
			local goal = CFrame.lookAt(cam.CFrame.Position, pos)
			local alpha = 1 - (math.clamp(S.Smooth, 0, 98) / 100) ^ (dt * 60)
			cam.CFrame = cam.CFrame:Lerp(goal, alpha)
		end
	end
	FovStroke.Color = locked and Color3.fromRGB(255, 255, 255) or S.FovColor
	updateStatus()
end

-- ESP
local espObjs = {}

local function createESP(p)
	if p == LP or espObjs[p] then return end
	local o = {}
	o.Box = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false }, overlay)
	o.BoxStroke = new("UIStroke", { Thickness = 1.5 }, o.Box)
	o.Name = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(160, 14), AnchorPoint = Vector2.new(0.5, 1),
		Font = Enum.Font.GothamBold, TextSize = 12, TextStrokeTransparency = 0.4, Visible = false,
	}, overlay)
	o.HpBg = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Visible = false }, overlay)
	o.Hp = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, o.HpBg)
	o.Tracer = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false }, overlay)
	espObjs[p] = o
end

local function hideESP(o)
	o.Box.Visible = false
	o.Name.Visible = false
	o.HpBg.Visible = false
	o.Tracer.Visible = false
	if o.HL then o.HL.Enabled = false end
end

local function destroyESP(p)
	local o = espObjs[p]
	if not o then return end
	for _, k in ipairs({ "Box", "Name", "HpBg", "Tracer", "HL" }) do
		if o[k] then pcall(function() o[k]:Destroy() end) end
	end
	espObjs[p] = nil
end

local function espStep()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local vs = cam.ViewportSize
	local t = os.clock()
	for p, o in pairs(espObjs) do
		local c = p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		local want = (S.ESP.All or S.Selected == p) and hrp and h and h.Health > 0 and isEnemy(p)
		if not want then
			hideESP(o)
		else
			local col
			if S.Selected == p then col = Color3.fromRGB(255, 215, 0)
			elseif S.ESP.Rainbow then col = Color3.fromHSV((t * 0.4) % 1, 1, 1)
			else col = S.ESP.Color end

			-- highlight
			if S.ESP.Highlight then
				if not o.HL or o.HL.Parent ~= c then
					if o.HL then pcall(function() o.HL:Destroy() end) end
					local hl = Instance.new("Highlight")
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.FillTransparency = 0.55
					hl.OutlineTransparency = 0
					hl.Parent = c
					o.HL = hl
				end
				o.HL.FillColor = col
				o.HL.OutlineColor = col
				o.HL.Enabled = true
			elseif o.HL then
				o.HL.Enabled = false
			end

			local pos, on = cam:WorldToViewportPoint(hrp.Position)
			if on then
				local head = c:FindFirstChild("Head")
				local topW = (head and head.Position or hrp.Position + Vector3.new(0, 2, 0)) + Vector3.new(0, 0.7, 0)
				local top = cam:WorldToViewportPoint(topW)
				local bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
				local height = math.abs(bot.Y - top.Y)
				local width = height * 0.55

				if S.ESP.Box then
					o.Box.Visible = true
					o.Box.Size = UDim2.fromOffset(width, height)
					o.Box.Position = UDim2.fromOffset(pos.X - width / 2, top.Y)
					o.BoxStroke.Color = col

					o.Name.Visible = true
					o.Name.TextColor3 = col
					o.Name.Position = UDim2.fromOffset(pos.X, top.Y - 2)
					o.Name.Text = p.DisplayName .. " [" .. math.floor((cam.CFrame.Position - hrp.Position).Magnitude) .. "m]"

					o.HpBg.Visible = true
					o.HpBg.Size = UDim2.fromOffset(3, height)
					o.HpBg.Position = UDim2.fromOffset(pos.X - width / 2 - 6, top.Y)
					local r = math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
					o.Hp.Size = UDim2.fromScale(1, r)
					o.Hp.BackgroundColor3 = Color3.fromRGB(255, 50, 50):Lerp(Color3.fromRGB(60, 255, 90), r)
				else
					o.Box.Visible = false
					o.Name.Visible = false
					o.HpBg.Visible = false
				end

				if S.ESP.Tracers then
					local from = Vector2.new(vs.X / 2, vs.Y)
					local to = Vector2.new(pos.X, pos.Y)
					local d = to - from
					o.Tracer.Visible = true
					o.Tracer.BackgroundColor3 = col
					o.Tracer.Size = UDim2.fromOffset(d.Magnitude, 1.5)
					o.Tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
					o.Tracer.Rotation = math.deg(math.atan2(d.Y, d.X))
				else
					o.Tracer.Visible = false
				end
			else
				o.Box.Visible = false
				o.Name.Visible = false
				o.HpBg.Visible = false
				o.Tracer.Visible = false
			end
		end
	end
end

-- FLY
local flyBV, flyBG
local flyVel = Vector3.zero

local function stopFly()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local h = hum()
	if h then h.PlatformStand = false end
end

local function startFly()
	local r, h = root(), hum()
	if not r or not h then return end
	stopFly()
	flyVel = Vector3.zero
	flyBV = new("BodyVelocity", { MaxForce = Vector3.one * 1e9, Velocity = Vector3.zero }, r)
	flyBG = new("BodyGyro", { MaxTorque = Vector3.one * 1e9, P = 9e4, CFrame = r.CFrame }, r)
	h.PlatformStand = true
end

local function flyStep(dt)
	if not S.Fly then return end
	local r, h = root(), hum()
	local cam = Workspace.CurrentCamera
	if not r or not h or not cam then return end
	if not flyBV or flyBV.Parent ~= r then startFly() end
	if not flyBV then return end

	local d = Vector3.zero
	if not UIS:GetFocusedTextBox() then
		local cf = cam.CFrame
		if UIS:IsKeyDown(Enum.KeyCode.W) then d += cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then d += cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then d += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then d -= Vector3.yAxis end
	end
	if d.Magnitude > 0 then d = d.Unit end
	flyVel = flyVel:Lerp(d * S.FlySpeed, math.clamp(dt * 8, 0, 1))
	flyBV.Velocity = flyVel
	flyBG.CFrame = cam.CFrame
end

-- SPEED / NOCLIP / INF JUMP
local origWalk
local function speedStep()
	local h = hum()
	if not h then return end
	if S.Speed then
		origWalk = origWalk or h.WalkSpeed
		if h.WalkSpeed ~= S.WalkSpeed then h.WalkSpeed = S.WalkSpeed end
	elseif origWalk then
		h.WalkSpeed = origWalk
		origWalk = nil
	end
end

local ncParts = {}
local function noclipStep()
	local c = LP.Character
	if not c then return end
	if S.Noclip then
		for _, p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				ncParts[p] = true
				p.CanCollide = false
			end
		end
	elseif next(ncParts) then
		for p in pairs(ncParts) do
			if p.Parent then p.CanCollide = true end
		end
		table.clear(ncParts)
	end
end


local function swatches(parent, text, init, cb)
	local r = row(parent, 40)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(60, 40),
		Font = Enum.Font.GothamMedium, TextSize = 14, Text = text, TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	themed(function() l.TextColor3 = Theme.Text end)
	local items = {}
	local cur = init
	local function render()
		for _, it in ipairs(items) do
			local sel = it.color == cur
			tw(it.stroke, { Thickness = sel and 3 or 1.5 }, 0.12)
			it.stroke.Color = sel and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
		end
	end
	for i, c in ipairs(Palette) do
		local b = new("TextButton", {
			Text = "", AutoButtonColor = false, BackgroundColor3 = c, Size = UDim2.fromOffset(22, 22),
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 72 + (i - 1) * 30, 0.5, 0),
		}, r)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
		local st = new("UIStroke", { Thickness = 1.5 }, b)
		table.insert(items, { color = c, stroke = st })
		b.MouseButton1Click:Connect(function()
			cur = c
			render()
			cb(c)
		end)
	end
	render()
end


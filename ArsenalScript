conn(UIS.InputBegan, function(i, gp)
	if Listening and i.UserInputType == Enum.UserInputType.Keyboard then
		if i.KeyCode ~= Enum.KeyCode.Escape then
			Binds[Listening.name] = i.KeyCode
			notify(i.KeyCode.Name .. " bound")
		end
		Listening.refresh()
		Listening = nil
		return
	end
	if gp or i.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local k = i.KeyCode
	if Binds.Menu == k then
		setMenu(not menuOpen)
	elseif Binds.Aimbot == k then
		ToggleAimbot.Set(not ToggleAimbot.Get())
	elseif Binds.Fly == k then
		ToggleFly.Set(not ToggleFly.Get())
	end
end)

conn(UIS.JumpRequest, function()
	if S.InfJump then
		local h = hum()
		if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

conn(Players.PlayerAdded, function(p)
	createESP(p)
	RefreshList()
end)
conn(Players.PlayerRemoving, function(p)
	destroyESP(p)
	if S.Selected == p then S.Selected = nil end
	task.defer(RefreshList)
end)
for _, p in ipairs(Players:GetPlayers()) do createESP(p) end

conn(LP.CharacterAdded, function()
	origWalk = nil
	table.clear(ncParts)
	if S.Fly then
		task.wait(0.5)
		startFly()
	end
end)

RunService:BindToRenderStep("UltraAim", Enum.RenderPriority.Camera.Value + 1, aimStep)
RunService:BindToRenderStep("UltraESP", Enum.RenderPriority.Camera.Value + 2, espStep)
conn(RunService.Heartbeat, function(dt)
	flyStep(dt)
	speedStep()
end)
conn(RunService.Stepped, noclipStep)

Unload = function()
	RunService:UnbindFromRenderStep("UltraAim")
	RunService:UnbindFromRenderStep("UltraESP")
	for _, c in ipairs(conns) do c:Disconnect() end
	S.Fly, S.Speed, S.Noclip = false, false, false
	stopFly()
	speedStep()
	noclipStep()
	for p in pairs(espObjs) do destroyESP(p) end
	gui:Destroy()
	overlay:Destroy()
end

